{
  "manifest_version": 3,
  "name": "LeetStreak",
  "version": "1.0.0",
  "description": "Track your LeetCode consistency with friends.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "LeetStreak",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "leetcode-page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "leetcode-listener.js",
        "history-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "leetcode-page-bridge.js"
      ],
      "matches": [
        "https://leetcode.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "leetstreak@example.com",
      "strict_min_version": "109.0"
    }
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://codestreak-api.onrender.com/*",
    "http://localhost:8000/*"
  ]
}
