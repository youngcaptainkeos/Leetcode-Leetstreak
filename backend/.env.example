DATABASE_URL=postgresql://codestreak:codestreak@localhost:5432/codestreak
# How often (minutes) the background job polls LeetCode for every registered user
POLL_INTERVAL_MINUTES=15
# Comma-separated list of allowed CORS origins. "*" is fine for local dev.
CORS_ORIGINS=*
# Required: generate a private random value; never commit the generated value.
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
APP_ENV=development
# Temporary signing keys are opt-in and never allowed in production.
ALLOW_EPHEMERAL_JWT=false
